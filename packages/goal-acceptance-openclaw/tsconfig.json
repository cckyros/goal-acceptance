{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": false,
    "composite": false,
    "incremental": false,
    "sourceMap": false,
    "declarationMap": false,
    "noEmit": false,
    "emitDeclarationOnly": false,
    "paths": {
      "@cckyros/goal-acceptance-core": ["../goal-acceptance-core/lib/types/index.d.ts"],
      "@cckyros/goal-acceptance-core/*": ["../goal-acceptance-core/lib/types/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
