{
  "name": "@cckyros/goal-acceptance-mcp",
  "description": "MCP server and Agent Plugin packaging for goal-acceptance criteria",
  "version": "0.1.0-rc.14",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cckyros/goal-acceptance.git",
    "directory": "packages/goal-acceptance-mcp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "goal-acceptance-mcp": "bin/mcp-server.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "bin/mcp-server.mjs",
    "plugin.json",
    "mcp.json",
    "skills"
  ],
  "license": "MIT",
  "dependencies": {
    "@cckyros/goal-acceptance-core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {}
}
