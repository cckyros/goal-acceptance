{
  "name": "@cckyros/goal-acceptance",
  "version": "0.2.3",
  "description": "Acceptance-criteria-driven goal completion for autonomous agents — MCP server, dsh Cordis plugin, and OpenClaw plugin in one package.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cckyros/goal-acceptance.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "goal-acceptance": "dist/cli.js"
  },
  "main": "dist/dsh-plugin.js",
  "openclaw": {
    "extensions": ["./openclaw-dist/openclaw-plugin.js"]
  },
  "files": [
    "dist/",
    "src/framework/",
    "src/plugin/",
    "src/assets/",
    "src/cli-entry.ts",
    "src/hook-entry.ts",
    "tests/",
    "build.mjs",
    "tsconfig.json",
    ".gitignore",
    "skills/",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    "marketplace.json",
    "cordis.patch.yml",
    "openclaw.plugin.json",
    "openclaw-dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "goal-acceptance",
    "acceptance-criteria",
    "mcp",
    "agent-plugins",
    "agent-skills",
    "claude-code",
    "codex",
    "dsh",
    "openclaw"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "verify": "npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.8",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "openclaw": "2026.7.1-2",
    "typebox": "^1.3.17",
    "typescript": "^7.0.2"
  }
}
